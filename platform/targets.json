{
  "schema": 1,
  "project": "DK Live Block",
  "single_source": "src",
  "supported_source": "firefox",
  "targets": {
    "firefox": {
      "engine": "gecko",
      "manifest": 2,
      "network_backend": "blocking-webrequest",
      "status": "development",
      "package": "xpi",
      "builder": "scripts/package-firefox.py"
    },
    "chrome": {
      "engine": "chromium",
      "manifest": 3,
      "network_backend": "declarative-net-request",
      "status": "adapter-required",
      "package": "zip"
    },
    "edge": {
      "engine": "chromium",
      "manifest": 3,
      "network_backend": "declarative-net-request",
      "status": "adapter-required",
      "package": "zip"
    }
  },
  "principle": "One shared source and Nesty coordinator. Browser-specific adapters activate only when supported; unsupported modules stay dormant or are omitted where packaging forbids them. No parity claim before browser tests.",
  "experimental_targets": {
    "orion-ios": {
      "engine": "webkit",
      "manifest": 2,
      "mode": "dom-only",
      "network_backend": "unverified",
      "status": "unverified-experimental",
      "package": "zip",
      "builder": "scripts/package-orion-candidate.py"
    },
    "orion-macos": {
      "engine": "webkit",
      "manifest": 2,
      "mode": "dom-only",
      "network_backend": "unverified",
      "status": "unverified-experimental",
      "package": "zip",
      "builder": "scripts/package-orion-candidate.py"
    },
    "orion-linux-beta": {
      "engine": "webkit",
      "status": "upstream-maintenance-ended-2026-10-02",
      "package": "none",
      "network_backend": "unverified"
    },
    "yandex-desktop": {
      "engine": "chromium",
      "manifest": 3,
      "network_backend": "declarative-net-request",
      "status": "adapter-required-unverified",
      "package": "zip",
      "builder": "none-until-tested"
    },
    "yandex-android": {
      "engine": "chromium",
      "manifest": 3,
      "network_backend": "unverified-on-mobile",
      "status": "adapter-required-unverified",
      "package": "none-until-tested",
      "builder": "none-until-tested"
    }
  }
}
