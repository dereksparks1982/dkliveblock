{
  "manifest_version": 2,
  "name": "DK Live Block",
  "version": "0.3.6",
  "description": "Unreleased, independent Firefox ad and tracker blocker",
  "browser_specific_settings": {
    "gecko": {
      "id": "dk-live-block@elderred-softworks.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "optional_permissions": ["nativeMessaging"],
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "storage",
    "alarms",
    "<all_urls>",
    "webNavigation",
    "proxy",
    "dns"
  ],
  "background": {
    "scripts": [
      "public-suffix.js",
      "rules.js",
      "engine.js",
      "privacy.js",
      "subscriptions.js",
      "manual-rules.js",
      "network-recovery.js",
      "list-io.js",
      "subscription-cache.js",
      "settings.js",
      "video-assist.js",
      "streaming-diagnostics.js",
      "streaming-repair.js",
      "request-monitor.js",
      "auth-protection.js",
      "youtube-maintenance.js",
      "video-library.js",
      "ghostery-vendor.js",
      "hybrid-engine.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "DK Live Block",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "consent.js",
        "procedural.js",
        "anti-adblock.js",
        "paywall.js",
        "video-assist.js",
        "streaming-watch.js",
        "overlay-recovery.js",
        "auth-protection.js",
        "popup-guard.js",
        "ad-recognition.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
