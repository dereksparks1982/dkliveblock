{
  "manifest_version": 2,
  "name": "DK Live Block",
  "version": "0.3.119",
  "description": "Unreleased, independent Firefox ad and tracker blocker",
  "browser_specific_settings": {
    "gecko": {
      "id": "dk-live-block@elderred-softworks.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "optional_permissions": [
    "nativeMessaging",
    "devtools"
  ],
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "storage",
    "browserSettings",
    "alarms",
    "<all_urls>",
    "webNavigation",
    "contextMenus",
    "proxy",
    "dns"
  ],
  "background": {
    "scripts": [
      "public-suffix.js",
      "rules.js",
      "engine.js",
      "privacy.js",
      "subscriptions.js",
      "language-lists.js",
      "manual-rules.js",
      "site-allowlist.js",
      "cosmetic-exceptions.js",
      "network-recovery.js",
      "list-io.js",
      "subscription-cache.js",
      "settings.js",
      "notification-protection.js",
      "context-menu.js",
      "video-assist.js",
      "streaming-diagnostics.js",
      "playback-health.js",
      "streaming-repair.js",
      "request-monitor.js",
      "request-controls.js",
      "popup-trap.js",
      "popup-history.js",
      "auth-protection.js",
      "youtube-maintenance.js",
      "video-library.js",
      "ghostery-vendor.js",
      "hybrid-engine.js",
      "icon-state.js",
      "rule-evidence.js",
      "allowed-activity.js",
      "rule-provenance.js",
      "ghostery-cosmetics.js",
      "youtube-feed.js",
      "youtube-response.js",
      "redirect-resources.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "DK Live Block",
    "default_popup": "popup.html",
    "default_icon": "icons/dk-live-block.png"
  },
  "devtools_page": "devtools.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "consent.js",
        "consent-dom.js",
        "distractions.js",
        "procedural.js",
        "anti-adblock.js",
        "paywall.js",
        "video-assist.js",
        "streaming-watch.js",
        "playback-health.js",
        "overlay-recovery.js",
        "auth-protection.js",
        "popup-guard.js",
        "ad-recognition.js",
        "cosmetic-debug.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtube-nocookie.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "youtube-feed.js",
        "youtube-page-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "icons": {
    "48": "icons/dk-live-block.png",
    "96": "icons/dk-live-block.png",
    "128": "icons/dk-live-block.png"
  },
  "web_accessible_resources": [
    "redirect/noop.js",
    "redirect/empty.css"
  ]
}
